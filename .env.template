ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
PUBLORA_API_KEY=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
TIMEZONE=America/New_York
REMINDERS_LIST=Social Posts

# Optional: override default DB path
# DB_PATH=promo_engine.db

# Optional: Negative Space photo library, for attaching a photo to Bluesky/Facebook posts
# PHOTO_DB_URL=postgresql://user:password@host:5432/photo_classifier

# Facebook: "browser" (default) stages the post in Chrome for you to click Post;
# "reminder" creates an Apple Reminder instead. Browser failures fall back to a Reminder.
# FACEBOOK_MODE=browser
# FB_BROWSER_PROFILE=~/Library/Application Support/promo_engine/facebook-chrome
# FB_DEBUG_PORT=9223
