<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.promo-engine.daily</string>

    <!-- Goes through run_with_retry.sh, never python3 directly. See README. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/billfordx/Developer/promo_engine/run_with_retry.sh</string>
        <string>/Users/billfordx/Developer/promo_engine/.venv/bin/python3</string>
        <string>/Users/billfordx/Developer/promo_engine/main.py</string>
        <string>--platform</string>
        <string>all</string>
    </array>

    <!-- Not under ~/Documents: iCloud eviction breaks scheduled runs. See README. -->
    <key>WorkingDirectory</key>
    <string>/Users/billfordx/Developer/promo_engine</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/billfordx/Developer/promo_engine/promo_engine.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/billfordx/Developer/promo_engine/promo_engine.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
